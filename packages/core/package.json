{
  "name": "@paymastech/sk-login-core",
  "version": "0.2.0",
  "description": "Sign in with Secret Keeper: protocol core (envelopes, two-step challenge, pending store), framework-agnostic",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/paymastech/sk-login.git", "directory": "packages/core" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/bip39": "^1.6.0"
  },
  "engines": { "node": ">=20" }
}
