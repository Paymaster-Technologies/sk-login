{
  "name": "@paymastech/sk-login-nestjs",
  "version": "0.6.0",
  "description": "Sign in with Secret Keeper and fill forms from the vault, for NestJS: SkLoginModule with init/status/code/target and request/init, request/status endpoints plus the app's /sk/login and /sk/request",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Paymaster-Technologies/sk-login.git", "directory": "packages/nestjs" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap"
  },
  "dependencies": {
    "@paymastech/sk-login-core": "0.6.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "reflect-metadata": ">=0.1.13"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0"
  },
  "engines": { "node": ">=20" }
}
